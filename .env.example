# Copy this file to .env and replace the placeholder with your own credential.
# Non-secret endpoint and model settings live in config/provider.jsonc.
HOMEWORK_TA_PROVIDER_CONFIG=config/provider.jsonc
HOMEWORK_TA_LLM_API_KEY=replace-with-your-dahl-key


# Ordered failover takes precedence over the single-provider config.
HOMEWORK_TA_ROUTER_CONFIG=config/router.jsonc
AGENTROUTER_API_KEY=replace-with-your-agentrouter-key
HORMOUZ_API_KEY=replace-with-your-hormouz-key
GCAT_API_KEY=replace-with-your-gcat-key
